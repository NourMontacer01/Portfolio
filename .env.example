# Copy this file to .env.local and fill in your own values.

# EmailJS (https://www.emailjs.com) — used by the contact form
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Google Tag Manager container id (optional)
NEXT_PUBLIC_GTM=GTM-XXXXXXX

# Public URL of the site, used by the contact form to reach /api/google
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"

# Google reCAPTCHA v2 (optional — the form works without it)
# The site key is public. The secret key must stay server-side: no NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key
RECAPTCHA_SECRET_KEY=your_secret_key
